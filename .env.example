# Copy this file to .env (ignored by git) and fill in the key. Never commit a real key.
# Real environment variables take priority over this file.
ANTHROPIC_API_KEY=

# To use NVIDIA's hosted models instead, set this key and PATCHPILOT_PROVIDER=nvidia.
NVIDIA_API_KEY=

# Optional settings, shown with their defaults.
# PATCHPILOT_PROVIDER=anthropic
# Model defaults depend on the provider; leave these unset to use them.
# PATCHPILOT_MODEL=
# PATCHPILOT_SMALL_MODEL=
# PATCHPILOT_NVIDIA_REQUESTS_PER_MINUTE=40
# PATCHPILOT_ROUTING=true
# PATCHPILOT_ROUTE_MAX_FILES=1
# PATCHPILOT_ROUTE_MAX_CHANGED_LINES=20
# PATCHPILOT_ROUTE_RISKY_PATTERN=(?i)password|sql
# PATCHPILOT_PROMPT_CACHE=true
# PATCHPILOT_CACHE_FILE_CONTEXT=false
# PATCHPILOT_RESPONSE_CACHE=true
# PATCHPILOT_CACHE_DIR=.patchpilot/cache
# PATCHPILOT_EFFORT=medium
# PATCHPILOT_MAX_TOKENS=16000
# PATCHPILOT_TIMEOUT_SECONDS=180
# PATCHPILOT_MAX_RETRIES=2
# PATCHPILOT_PROMPT_VERSION=v2
# PATCHPILOT_MAX_PROMPT_CHARS=200000
# PATCHPILOT_TEST_TIMEOUT_SECONDS=60
# PATCHPILOT_DB_PATH=.patchpilot/usage.db
